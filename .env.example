# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://string_theory:string_theory@127.0.0.1:5432/string_theory

DATABASE_POOL_MAX=10

DATABASE_SSL=disable

POSTGRES_DB=string_theory
POSTGRES_USER=string_theory
POSTGRES_PASSWORD=string_theory
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
SESSION_SECRET=
DEV_AUTH_EMAIL=ada@stringtheory.test

ALLOW_UNAUTHENTICATED_SIGNUP=true

# ---------------------------------------------------------------------------
# Google sign-in (/signin, /dashboard, /campaigns/new)
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_BASE_URL=

# ---------------------------------------------------------------------------
# Admin console (/admin)
# ---------------------------------------------------------------------------

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

ADMIN_EMAIL=admin@stringtheory.test
ADMIN_NAME=Network admin

# ---------------------------------------------------------------------------
# DBMS console (/admin/dbms)
# Separate dedicated credentials for the database relational schema & records viewer
# ---------------------------------------------------------------------------
DBMS_USERNAME=dbadmin
DBMS_PASSWORD=dbms_secret_password

# ---------------------------------------------------------------------------
# S3 video storage
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1
S3_ORIGINAL_BUCKET=string-theory-original-videos
S3_ENCODED_BUCKET=string-theory-encoded-videos

# ---------------------------------------------------------------------------
# Pydantic Logfire Observability (/admin)
# Tracing, spans, and telemetry for all admin requests, processing, success & failures
# ---------------------------------------------------------------------------
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=string-theory-marketing
LOGFIRE_SERVICE_VERSION=0.1.0
LOGFIRE_ENVIRONMENT=development

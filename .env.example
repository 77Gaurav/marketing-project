# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in:  cp .env.example .env
#
# Point this at your PostgreSQL instance. For local development that is the compose service below;
# for production it is a Postgres on an EC2 instance with the data directory on an EBS volume. See
# deploy/postgres.md for the EBS provisioning steps.
#
# The password must be URL-encoded if it contains characters that are special in a URL (@ : / ? #).
DATABASE_URL=postgres://string_theory:string_theory@127.0.0.1:5432/string_theory

# Connection pool size per server process. Keep it well under the instance's max_connections divided
# by the number of app processes: 4 instances x 10 + migrations + admin headroom is a safe shape for
# the default max_connections of 100.
DATABASE_POOL_MAX=10

# Set to "require" when connecting to a managed instance or across a network that is not localhost.
# Plain "disable" is correct for the local compose service.
DATABASE_SSL=disable

# Credentials for the local compose service only. docker-compose.yml reads these; the application
# never does. In production these live in the instance's environment, not in a checked-in file.
POSTGRES_DB=string_theory
POSTGRES_USER=string_theory
POSTGRES_PASSWORD=string_theory
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# HMAC key for the session cookie. Must be at least 32 characters, and must be different in every
# environment — a shared key means a cookie minted on staging is valid in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in production. Ignored in development, where an ephemeral key is generated on boot.
SESSION_SECRET=

# Identity used when a request carries no session cookie. Ignored when NODE_ENV=production.
# Set this to one of the accounts created by `npm run db:seed`:
#   ada@stringtheory.test   BRAND — may create campaigns
#   cafe@stringtheory.test STORE — refused with a 403
#   ops@stringtheory.test  ADMIN — may create campaigns and manage the network at /admin
DEV_AUTH_EMAIL=ada@stringtheory.test

# Allows creating a campaign with no session by provisioning a BRAND account from the submitted
# contact email. This is the pre-auth bootstrap path: it is what makes the flow work before a login
# page exists. MUST be false (the default) in production — with it on, anyone who can post to
# /api/campaigns can create a brand.
ALLOW_UNAUTHENTICATED_SIGNUP=true

# ---------------------------------------------------------------------------
# Admin console (/admin)
# ---------------------------------------------------------------------------
# A single shared username and password, checked against the environment rather than a users row,
# because there is no password hashing anywhere in this project yet. See lib/auth/admin.ts.
#
# These defaults are a development convenience. The server REFUSES TO START when NODE_ENV=production
# and ADMIN_PASSWORD is still "admin" or is shorter than 12 characters, so the default cannot reach a
# real deployment by accident — but a long password is not the same as a hashed one, and a rate limit
# on the login route is still missing. Both are noted in deploy/postgres.md.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# The users row that an /admin login resolves to. users.email is the login identity in this schema, so
# the username above is the credential checked against the environment while this is the account whose
# ADMIN role the session then carries. Created on first login if it does not exist; if the address
# already belongs to an account with a different role, sign-in is refused rather than that account
# being silently promoted.
ADMIN_EMAIL=admin@stringtheory.test
ADMIN_NAME=Network admin